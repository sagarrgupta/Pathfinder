# ── Pathfinder Environment Configuration ──
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Neo4j (required) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── LM Studio (optional — defaults work for local setup) ──
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=openai/gpt-oss-20b
# VISION_MODEL=qwen/qwen3-vl-8b

# ── Ollama (optional — defaults work for local setup) ──
# OLLAMA_URL=http://localhost:11434

# ── Web Search API Keys (optional — falls back to DuckDuckGo) ──
# Tavily: https://tavily.com (recommended, 1000 free searches/month)
TAVILY_API_KEY=
# Brave: https://brave.com/search/api/ (2000 free queries/month)
BRAVE_API_KEY=
