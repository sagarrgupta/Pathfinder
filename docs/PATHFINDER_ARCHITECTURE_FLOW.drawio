        <mxCell id="rwe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-load" target="rw-profile-search"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rwe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-search" target="rw-profile-pack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rwe8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-pack" target="rw-profile-infer"><mxGeometry relative="1" as="geometry"/></mxCell>
