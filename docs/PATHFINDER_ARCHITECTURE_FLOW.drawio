  <diagram id="document-page" name="04 Document Ingestion">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="doc-title" value="Detailed Document Ingestion and Knowledge Extraction Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="doc1" value="doc_analyst starts&#xa;Reads files, session_id, student_id, scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="doc2" value="Files present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="105" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc3" value="Return unchanged state&#xa;- add 'No files to process' progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="doc4" value="For each uploaded file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="doc5" value="Detect file type&#xa;pdf / image / docx / text / unsupported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="255" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="doc6" value="Supported type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc7" value="Skip unsupported file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="doc8" value="execute_document_ingestion()&#xa;- routes by file type&#xa;- Docling-first extraction pipeline&#xa;- returns pages, plain_text, markdown_text, structured_chunks, backend metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="doc9" value="Extraction succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="400" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc10" value="Add recovery event&#xa;recovery_for_document_extraction_failure()&#xa;Skip this file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="850" y="390" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="doc11" value="Normalize text outputs&#xa;- derive plain_text&#xa;- derive markdown_text&#xa;- fallback from pages if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="doc12" value="Text empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="570" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc13" value="Add empty extraction recovery event&#xa;Skip file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="doc14" value="Infer document role&#xa;- resume&#xa;- transcript&#xa;- general_document&#xa;- other semantic role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="730" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="doc15" value="If transcript: build_transcript_state_from_sources()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="590" y="750" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="doc16" value="store_document_node()&#xa;- document_id&#xa;- filename / scope&#xa;- role / confidence / signals&#xa;- extraction backend metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="930" y="725" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="doc17" value="If transcript: store_evidence(source_type=transcript_state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1240" y="750" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="doc18" value="Chunking strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="910" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="doc19" value="Structured chunks available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="900" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc20" value="Use Docling structured chunks&#xa;- headings&#xa;- item labels&#xa;- page numbers&#xa;- chunk_method=docling_hybrid_chunker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="890" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="doc21" value="Fallback chunking&#xa;RecursiveCharacterTextSplitter&#xa;+ best-effort page mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="1010" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="doc22" value="aembed_documents()&#xa;- create embeddings for chunk texts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1040" y="920" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="doc23" value="Embedding/store success?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1320" y="910" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="doc24" value="store_chunks() in vector index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1530" y="920" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="doc25" value="Add embedding failure recovery event&#xa;Document metadata remains available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1010" width="230" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="doc26" value="LLM entity extraction&#xa;- prompt with plain_text / markdown / structured chunk context&#xa;- parse JSON&#xa;- entities + student_properties" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1780" y="900" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="doc27" value="store_extracted_entities()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
