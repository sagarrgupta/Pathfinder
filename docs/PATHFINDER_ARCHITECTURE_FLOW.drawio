          <mxGeometry x="320" y="100" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-ingest-q" value="Current query looks like profile signal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="570" y="90" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-ingest" value="ingest_memory(source=chat_query)&#xa;- candidate facts&#xa;- memory items&#xa;- promoted entities&#xa;- student updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-load" value="get_full_profile(student_id)&#xa;- personal&#xa;- courses&#xa;- skills&#xa;- goals&#xa;- documents&#xa;- candidate facts / evidence / memory_items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="80" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-search" value="hybrid_search(query, k=5, student_id, session_id)&#xa;- vector + graph aware retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1430" y="90" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-pack" value="build_memory_pack()&#xa;- semantic_memory&#xa;- conflicts&#xa;- saved_recommendations&#xa;- decision_records&#xa;- fallback documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1720" y="80" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-infer" value="Derive planning context&#xa;- session_summary&#xa;- query_focus&#xa;- workflow&#xa;- target_entity&#xa;- student_strategy&#xa;- operating_model&#xa;- decision_continuity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="260" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-source" value="Build/govern source_policy&#xa;- preferred domains&#xa;- target institution/program/level&#xa;- strict source requirements&#xa;- targeted_web_questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1460" y="260" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-evidence" value="build_evidence_pack()&#xa;- profile records&#xa;- document records&#xa;- web records&#xa;- semantic memory&#xa;- evidence records&#xa;- missing information" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1780" y="260" width="240" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rw-profile-next" value="Return updated state to next node&#xa;- usually web_researcher, fact_extractor, or advisory node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1780" y="450" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="rw-web-title" value="web_researcher subflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-start" value="web_researcher starts&#xa;- reads source_policy + targeted_web_questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-url" value="Extract explicit URLs from query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="700" width="180" height="60" as="geometry"/>
        </mxCell>
