        <mxCell id="lg-eval" value="evaluator&#xa;- groundedness / confidence&#xa;- rewrite / patch&#xa;- passive profile updates&#xa;- trace_summary / stop_reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
