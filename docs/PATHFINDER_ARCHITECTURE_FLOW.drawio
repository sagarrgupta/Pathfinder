          <mxGeometry x="590" y="690" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-fetch" value="fetch_url_content()&#xa;- direct page content&#xa;- add to web_results&#xa;- log provenance&#xa;- audit trust / fit / freshness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="680" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-generate" value="Generate smart queries&#xa;- URL-aware prompt if URLs present&#xa;- else standard profile-aware prompt&#xa;- merge targeted questions&#xa;- expand with domains and policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="670" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-search" value="search() fallback chain&#xa;- run each generated query&#xa;- retry if configured&#xa;- record tool_call_log entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1430" y="680" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-score" value="Score + dedupe results&#xa;- domain preference&#xa;- source relevance&#xa;- target program / level / institution fit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1730" y="680" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-fetchbest" value="Fetch strongest search hits&#xa;within fetch budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1430" y="840" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-filter" value="Classify / filter sources&#xa;- source_type&#xa;- trust tier&#xa;- fit tier&#xa;- freshness tier&#xa;- strict_primary_only rules&#xa;- institution-match rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1690" y="830" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="rw-web-return" value="Return updated state&#xa;- web_results&#xa;- working_memory source audit&#xa;- tool_call_log&#xa;- task_graph status&#xa;- next advisory/prep node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="990" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="rwe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-start" target="rw-profile-ensure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rwe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-ensure" target="rw-profile-ingest-q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rwe3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-ingest-q" target="rw-profile-ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rwe4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="rw-profile-ingest-q" target="rw-profile-load"><mxGeometry relative="1" as="geometry">
