  <diagram id="langgraph-page" name="03 LangGraph Routing">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lg-title" value="LangGraph Routing and Shared State Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg-state" value="PathfinderState&#xa;Shared fields include:&#xa;- query, files, student_id, session_id&#xa;- intent, plan, next_node, workflow&#xa;- profile_data, documents, web_results&#xa;- evidence_pack, decision_payload&#xa;- draft_answer, final_answer&#xa;- confidence, citations, trace_summary&#xa;- recovery_events, blocked_reasons, step_progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="310" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="lg-start" value="Graph Entry" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lg-input" value="input_guard&#xa;- empty / length / injection checks&#xa;- topic guard (unless disabled)&#xa;- can short-circuit to responder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="lg-block" value="Blocked?&#xa;is_blocked + block_reason" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="990" y="100" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lg-orch" value="orchestrator&#xa;- preload profile summary&#xa;- infer workflow / target / source policy&#xa;- use deterministic plan or LLM routing&#xa;- insert ordering guardrails&#xa;- apply dependency gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="80" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="lg-clar" value="clarifier&#xa;- asks for missing info&#xa;- then responder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1540" y="40" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lg-doc" value="doc_analyst&#xa;- extraction&#xa;- chunking / embedding&#xa;- document roles&#xa;- transcript state&#xa;- entity extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1520" y="150" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="lg-profile" value="profile_manager&#xa;- ensure student&#xa;- in-turn memory ingestion&#xa;- load profile&#xa;- hybrid retrieval&#xa;- evidence pack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1740" y="140" width="190" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="lg-web" value="web_researcher&#xa;- direct URL fetch&#xa;- smart query generation&#xa;- search + filtering&#xa;- source audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1960" y="150" width="180" height="120" as="geometry"/>
        </mxCell>

