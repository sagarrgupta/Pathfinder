        </mxCell>
        <mxCell id="rs3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Resolve session_id&#xa;- keep caller value if present&#xa;- else generate_session_id()" vertex="1">
          <mxGeometry height="90" width="200" x="720" y="105" as="geometry" />
        </mxCell>
        <mxCell id="rs4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Parse replace_filenames&#xa;- comma-separated list&#xa;- delete matching old document nodes + chunks before re-upload" vertex="1">
          <mxGeometry height="110" width="240" x="990" y="95" as="geometry" />
        </mxCell>
        <mxCell id="rs5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Read uploaded files&#xa;- validate filename/type&#xa;- enforce max size&#xa;- load bytes into memory&#xa;- normalize filename/content/size/content_type" vertex="1">
          <mxGeometry height="120" width="250" x="1310" y="90" as="geometry" />
        </mxCell>
        <mxCell id="rs6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="get_compiled_graph()&#xa;- build_graph()&#xa;- get_checkpointer()&#xa;- graph.compile(checkpointer=SqliteSaver)" vertex="1">
