        <mxCell id="rs1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Incoming POST /api/v1/chat&#xa;Fields: query, session_id, student_id, files, is_global_upload, replace_filenames, advisor_mode" vertex="1">
          <mxGeometry height="120" width="280" x="60" y="90" as="geometry" />
